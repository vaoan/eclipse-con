# Production build settings for the archived Moonfest 2026 site.
#
# The site is served by an assets-only Worker (wrangler.archive.toml), so there
# is no longer a Worker injecting `window.__ECLIPSE_CON_RUNTIME_CONFIG__` at
# request time. That injection used to hand every VITE_* key an empty string,
# and `readEnv` returns any string it finds — so the empties won and analytics
# was off in production regardless of what the build baked in.
#
# These values keep that behaviour explicit now that the build is the only
# source: the archive ships no analytics keys and reports nothing. Vite loads
# `.env.production` at higher priority than `.env.local`, so a developer's local
# keys cannot leak into an archive build.
VITE_ANALYTICS_ENABLED=false
VITE_CF_WEB_ANALYTICS_ENABLED=false
VITE_GA_MEASUREMENT_ENABLED=false
VITE_GTM_ENABLED=false
VITE_CF_WEB_ANALYTICS_TOKEN=
VITE_POSTHOG_API_KEY=
VITE_GA_MEASUREMENT_ID=
VITE_GTM_CONTAINER_ID=

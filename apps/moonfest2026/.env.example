# Copy to .env.local and fill values
VITE_APP_NAME="Moonfest 2026"
VITE_DEFAULT_LOCALE=en
VITE_SUPPORTED_LOCALES=en,es
VITE_DEBUG=false
VITE_ENABLE_TEST_IDS=false
VITE_APP_VERSION="2458"
VITE_ANALYTICS_ENABLED=false
# VITE_ANALYTICS_ENDPOINT=https://analytics.your-domain.example/collect
# VITE_CF_WEB_ANALYTICS_ENABLED=false
# VITE_CF_WEB_ANALYTICS_TOKEN=your_cloudflare_web_analytics_token
# VITE_GA_MEASUREMENT_ENABLED=true
# VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX
# VITE_GTM_ENABLED=true
# VITE_GTM_CONTAINER_ID=GTM-XXXXXXX
# VITE_POSTHOG_API_KEY=phc_your_posthog_project_api_key
# VITE_POSTHOG_HOST=https://us.i.posthog.com
# VITE_ANALYTICS_PROFILE=lean # use "full" only when you intentionally want high-volume diagnostics

# Telegram sync (used by pnpm fetch:telegram / translate:telegram / sync:telegram)
# Feed target/thread/since values live in ./telegram.config.json, not here.
# Account credentials and translation provider secrets are shared across apps
# via the repo-root .env.local (see packages/telegram-sync/README.md):
# TELEGRAM_API_ID=123456
# TELEGRAM_API_HASH=your_api_hash
# TELEGRAM_PHONE=+123456789

# Telegram translation provider (set in the repo-root .env.local)
# TRANSLATE_PROVIDER=codex
# TRANSLATE_TO=en
#
# Codex CLI
# TRANSLATE_PROVIDER=codex
# Optional: CODEX_MODEL=gpt-5.2-codex
#
# Claude Code CLI with Codex fallback when CLI access/subscription fails
# TRANSLATE_PROVIDER=claude_code
# Optional: CODEX_MODEL=gpt-5.2-codex
#
# Claude / Anthropic (recommended)
# TRANSLATE_PROVIDER=claude
# ANTHROPIC_API_KEY=your_anthropic_api_key
# CLAUDE_MODEL=claude-haiku-4-5
#
# OpenAI
# TRANSLATE_PROVIDER=openai
# OPENAI_API_KEY=your_openai_api_key
# OPENAI_MODEL=gpt-4o-mini
#
# Azure AI Translator
# TRANSLATE_PROVIDER=azure
# AZURE_TRANSLATOR_KEY=your_azure_translator_key
# AZURE_TRANSLATOR_REGION=your_resource_region
# AZURE_TRANSLATOR_ENDPOINT=https://api.cognitive.microsofttranslator.com
# AZURE_TRANSLATOR_FROM=es
# If OPENAI_API_KEY is set while provider=azure, script auto-falls back to OpenAI per message.
